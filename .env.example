# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_SITE_KEY=your-turnstile-site-key

# Auth security (generate each with: openssl rand -base64 32)
SESSION_SECRET=your-session-signing-secret
SETUP_SECRET=your-initial-setup-secret

# OAuth Providers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Owner identity (numeric GitHub user ID)
GITHUB_OWNER_ID=your-github-user-id

# LLM API Configuration
LLM_API_KEY=your-llm-api-key
LLM_API_URL=https://api.example.com/v1/chat
