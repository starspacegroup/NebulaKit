# Local development environment variables for Cloudflare Workers
# Copy this file to .dev.vars and fill in your actual values

# GitHub OAuth Configuration
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_OWNER_ID=your_github_user_id_here

# Discord OAuth Configuration
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Cloudflare Turnstile (optional — bot protection for the public contact form)
# Get these from https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset to run the contact form without a captcha (form still works).
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Dev-only simulated ("pretend") login.
# When set to "true", /auth/login exposes a User/Admin/Superadmin role toggle and
# PRETEND provider buttons, letting you sign in without any OAuth configured.
# By default simulation is enabled only on localhost; set this to reach it from a
# dev tunnel (e.g. dev-<app>-<hash>.example.com). NEVER set this in production.
DEV_AUTH_BYPASS=true

# Shared bearer secret for /api/cron/* scheduler endpoints (currently the
# page-view stats retention prune — see docs/ADMIN_STATS.md). Any scheduler POSTs
# with `Authorization: Bearer <this>`. Unset means those endpoints answer 503.
# CRON_SECRET=your_long_random_secret_here

# Note: .dev.vars is gitignored and should never be committed
# These values are used by `wrangler dev` for local development
